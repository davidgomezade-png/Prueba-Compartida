const int boton = 2;
const int led = 13;

void setup() {
  pinMode(boton, INPUT_PULLUP);  // Activa resistencia interna
  pinMode(led, OUTPUT);
}

void loop() {
  if (digitalRead(boton) == LOW) {  // Cuando presionas el botón
    digitalWrite(led, HIGH);        // Enciende LED
  } else {
    digitalWrite(led, LOW);         // Apaga LED
  }
}
