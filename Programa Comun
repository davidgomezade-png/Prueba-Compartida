const int boton = 2;
const int ledNormal = 13;
const int ledInvertido = 12;

void setup() {
  pinMode(boton, INPUT_PULLUP);
  pinMode(ledNormal, OUTPUT);
  pinMode(ledInvertido, OUTPUT);
}

void loop() {
  if (digitalRead(boton) == LOW) {  
    // Botón presionado
    digitalWrite(ledNormal, HIGH);      // Normal encendido
    digitalWrite(ledInvertido, LOW);    // Invertido apagado
  } else {
    // Botón NO presionado
    digitalWrite(ledNormal, LOW);       
    digitalWrite(ledInvertido, HIGH);   
  }
}
